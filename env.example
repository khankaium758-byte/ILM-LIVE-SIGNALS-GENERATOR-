import { GoogleGenAI, Type } from "@google/genai";

const ai = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY });

export interface SignalResponse {
  signalId: string;
  asset: string;
  price: string;
  accuracy: number;
  direction: 'CALL' | 'PUT' | 'WAIT';
  tradeTime: string;
  candlesAnalyzed: number;
  rsi: number;
  trendStrength: number;
  volatility: number;
}

export async function generateAisignal(asset: string, strategies: string[], currentPrice?: number): Promise<SignalResponse> {
  try {
    const signalId = `ZENO-${Math.random().toString(36).substring(2, 8).toUpperCase()}`;
    const prompt = `
      Perform an elite-level technical analysis for ${asset} using: ${strategies.join(', ')}.
      Current Market Price: ${currentPrice || 'Loading...'}
      Signal ID: ${signalId}
      
      You are the ZENO Quantum Analyser. Your task is to find a high-probability opportunity 
      for a 1-minute expiry. Use advanced confluence between RSI, EMA, and SMC (Smart Money Concepts).
      
      Output real-time simulated data for:
      - signalId: Use the provided ID ${signalId}.
      - Direction: CALL (if momentum is bullish), PUT (if momentum is bearish), or WAIT (if the market is unstable, ranging, or no clear entry exists).
      - Price: The projected strike price based on the current price ${currentPrice || ''}.
      - Accuracy: A strictly monitored confidence score (89-97). 
      
      CRITICAL: If the analysis reveals an uncertain trend or low confidence, you MUST return 'direction': 'WAIT'. Do not force a trade.
      'WAIT' should be returned if accuracy is projected to be below 94%.
      - Indicators: Correlated values for RSI, Trend, and Volatility.
      
      IMPORTANT: The 'tradeTime' MUST be the start of the next minute from now (e.g. if it is 10:05:45, tradeTime is 10:06:00).
    `;

    const response = await ai.models.generateContent({
      model: "gemini-3-flash-preview",
      contents: prompt,
      config: {
        responseMimeType: "application/json",
        responseSchema: {
          type: Type.OBJECT,
          properties: {
            signalId: { type: Type.STRING },
            asset: { type: Type.STRING },
            price: { type: Type.STRING },
            accuracy: { type: Type.NUMBER },
            direction: { 
              type: Type.STRING,
              enum: ["CALL", "PUT", "WAIT"]
            },
            tradeTime: { type: Type.STRING },
            candlesAnalyzed: { type: Type.NUMBER },
            rsi: { type: Type.NUMBER },
            trendStrength: { type: Type.NUMBER },
            volatility: { type: Type.NUMBER }
          },
          required: ["signalId", "asset", "price", "accuracy", "direction", "tradeTime", "candlesAnalyzed", "rsi", "trendStrength", "volatility"]
        }
      }
    });

    const signalData = JSON.parse(response.text.trim());
    return signalData;
  } catch (error) {
    console.error("Error generating signal with Gemini:", error);
    // Fallback mock data if API fails
    const now = new Date();
    const signalId = `ZENO-FB-${Math.random().toString(36).substring(2, 8).toUpperCase()}`;
    now.setMinutes(now.getMinutes() + 1);
    now.setSeconds(0);
    return {
      signalId,
      asset: asset,
      price: (Math.random() + 0.5).toFixed(5),
      accuracy: 85,
      direction: Math.random() > 0.6 ? 'WAIT' : (Math.random() > 0.5 ? 'CALL' : 'PUT'),
      tradeTime: now.toLocaleTimeString([], { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' }),
      candlesAnalyzed: 342,
      rsi: 54,
      trendStrength: 72,
      volatility: 0.12
    };
  }
}
